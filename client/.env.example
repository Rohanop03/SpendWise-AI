# Vite exposes VITE_-prefixed values to browser code. Never put secrets here.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Public origin of the deployed frontend, e.g. https://spendwise.example. Used for canonical
# URLs, Open Graph URLs and sitemap.xml. Leave empty locally; those tags are then omitted.
VITE_SITE_URL=
