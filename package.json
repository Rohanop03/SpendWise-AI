{
  "name": "spendwise-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Full-stack foundation for SpendWise AI",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names client,server --prefix-colors cyan,green \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "db:check": "npm run db:check --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:seed:demo": "npm run db:seed:demo --workspace server",
    "db:advanced:verify": "npm run db:advanced:verify --workspace server",
    "db:benchmark": "npm run db:benchmark --workspace server",
    "db:demo": "npm run db:demo --workspace server",
    "reminders:run-once": "npm run reminders:run-once --workspace server",
    "reminders:worker": "npm run reminders:worker --workspace server",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "npm run test:db --workspace server",
    "test:journeys": "node server/scripts/verifyUserJourneys.js",
    "test:e2e": "playwright test",
    "build": "npm run build --workspace client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:visual": "playwright test -c playwright.visual.config.js",
    "test:regression": "playwright test e2e/regression.spec.js",
    "screenshots": "playwright test -c playwright.visual.config.js screenshots",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "preview:dist": "node client/scripts/serve-dist.mjs"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
