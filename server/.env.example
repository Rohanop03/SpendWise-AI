# Runtime
NODE_ENV=development
PORT=5000

# Browser origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connections. Replace YOUR_PASSWORD locally and URL-encode reserved characters.
# Never commit real credentials. Keep the test database separate from development data.
# Local Docker setup (see README): container ssm-postgres published on host port 5434.
DATABASE_URL=postgresql://ssm:YOUR_PASSWORD@localhost:5434/smart_subscription
TEST_DATABASE_URL=postgresql://ssm:YOUR_PASSWORD@localhost:5434/smart_subscription_test

# Demo records are fictional and require both development mode and this explicit opt-in.
ALLOW_DEMO_SEED=false

# Authentication. Generate a private random value of at least 32 characters locally.
# Never reuse this placeholder or expose the real value to the frontend.
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_COST=12
AUTH_RATE_LIMIT_MAX=10

# Use false only for HTTP localhost development. Production requires HTTPS and true.
COOKIE_SECURE=false

# Production reverse proxy and database SSL settings
# TRUST_PROXY: set to 'loopback', '1', or true if behind a reverse proxy (e.g., Render, Railway, Nginx)
# TRUST_PROXY=1
# DATABASE_SSL: set to true to enforce SSL connections to PostgreSQL in hosted environments (e.g., Render, Supabase, Neon)
# DATABASE_SSL=false

# Reminder worker (run separately from the HTTP API)
REMINDER_INTERVAL_MINUTES=60
REMINDER_BATCH_SIZE=500
